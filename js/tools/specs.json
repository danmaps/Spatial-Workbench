    "headlessSupported": true,
    "parameters": [
      {
        "name": "Layer A",
        "description": "Baseline polygon layer (A)",
        "type": "dropdown",
        "defaultValue": "",
        "required": true
      },
      {
        "name": "Layer B",
        "description": "Comparison polygon layer (B)",
        "type": "dropdown",
        "defaultValue": "",
        "required": true
      }
    ],
    "execution": {
      "stateMode": "layers",
      "inputs": [
        {
          "parameter": "Layer A",
          "kind": "layer",
          "geometryTypes": [
            "Polygon",
            "MultiPolygon"
          ],
          "cardinality": "one",
          "selectionAware": true
        },
        {
          "parameter": "Layer B",
          "kind": "layer",
          "geometryTypes": [
            "Polygon",
            "MultiPolygon"
          ],
          "cardinality": "one",
          "selectionAware": false
        }
      ],
      "outputs": [
        {
          "kind": "layer",
          "operation": "add",
