[
  {
    "key": "AddDataTool",
    "name": "Add Data",
    "description": "Upload GeoJSON or tabular data (CSV/XLSX) with coordinates",
    "headlessSupported": false,
    "parameters": [
      {
        "name": "Input",
        "description": "data to add",
        "type": "file",
        "defaultValue": "",
        "required": true
      },
      {
        "name": "Lat Column",
        "description": "latitude column name",
        "type": "dropdown",
        "defaultValue": ""
      },
      {
        "name": "Long Column",
        "description": "longitude column name",
        "type": "dropdown",
        "defaultValue": ""
      },
      {
        "name": "Override Columns",
        "description": "manually specify columns",
        "type": "boolean",
        "defaultValue": false
      }
    ],
    "execution": {
      "stateMode": "browser",
      "inputs": [],
      "outputs": [],
      "mutatesState": false,
      "producesArtifacts": false
    }
  },
  {
    "key": "BufferTool",
    "name": "Buffer",
    "description": "Makes a buffer around the input layer",
    "headlessSupported": true,
    "parameters": [
      {
        "name": "Input Layer",
        "description": "The input layer to buffer",
        "type": "dropdown",
        "defaultValue": "",
        "required": true
      },
      {
        "name": "Distance",
        "description": "The distance",
        "type": "float",
        "defaultValue": 10,
        "required": true
      },
      {
        "name": "Units",
        "description": "The units for the distance",
        "type": "dropdown",
        "defaultValue": "miles",
        "options": [
          "feet",
          "meters",
          "miles",
          "kilometers",
          "degrees"
        ],
        "required": true
      }
    ],
    "execution": {
      "stateMode": "layers",
      "inputs": [
        {
          "parameter": "Input Layer",
          "kind": "layer",
          "geometryTypes": [
            "Point",
            "MultiPoint",
            "LineString",
            "MultiLineString",
            "Polygon",
            "MultiPolygon"
          ],
          "cardinality": "one",
          "selectionAware": true
        }
      ],
      "outputs": [
        {
          "kind": "layer",
          "operation": "add",
          "geometryType": "Polygon"
        }
      ],
      "mutatesState": true,
      "producesArtifacts": false
    }
  },
  {
    "key": "ExportTool",
    "name": "Export",
    "description": "Export data as GeoJSON, CSV, or WKT",
    "headlessSupported": true,
    "parameters": [
      {
        "name": "Layer",
        "description": "layer to export",
        "type": "dropdown",
        "defaultValue": "",
        "required": true
      },
      {
        "name": "Format",
        "description": "format to export",
        "type": "dropdown",
        "defaultValue": "geojson",
        "options": [
          "geojson",
          "csv",
          "wkt"
        ],
        "required": true
      }
    ],
    "execution": {
      "stateMode": "layers",
      "inputs": [
        {
          "parameter": "Layer",
          "kind": "layer",
          "geometryTypes": [
            "Point",
            "MultiPoint",
            "LineString",
            "MultiLineString",
            "Polygon",
            "MultiPolygon"
          ],
          "cardinality": "one",
          "selectionAware": true
        }
      ],
      "outputs": [
        {
          "kind": "artifact",
          "operation": "create",
          "artifactType": "download"
        }
      ],
      "mutatesState": false,
      "producesArtifacts": true
    }
  },
  {
    "key": "GenerateAIFeatures",
    "name": "Generate AI Features",
    "description": "Generates GeoJSON map features from a natural-language prompt using the AI provider and model configured in Settings.",
    "headlessSupported": false,
    "parameters": [
      {
        "name": "Prompt",
        "description": "The prompt to generate AI features",
        "type": "text",
        "defaultValue": "",
        "required": true
      }
    ],
    "execution": {
      "stateMode": "browser",
      "inputs": [],
      "outputs": [],
      "mutatesState": false,
      "producesArtifacts": false
    },
    "notes": [
      "Model selection follows your saved Settings panel configuration (stored in localStorage under SWB_AI_PROVIDER and SWB_AI_MODEL).",
      "If you specify a custom Model in Settings, Generate AI Features uses that exact model.",
      "If no custom Model is set, it falls back to the active provider's default model: OpenRouter (default provider) -> openai/gpt-4o, OpenAI -> gpt-4o, Built-in AI (Ollama) -> qwen2.5-coder:1.5b (or the local model selected in Settings).",
      "OpenRouter and OpenAI use your client-side API key (SWB_API_KEY) when provided, or the server's configured key if enabled; Built-in AI (Ollama) requires no API key."
    ]
  },
  {
    "key": "GroupTool",
    "name": "Group",
    "description": "Groups nearby features by distance and adds the grouped result as a new layer",
    "headlessSupported": true,
    "parameters": [
      {
        "name": "Layer",
        "description": "layer to group",
        "type": "dropdown",
        "defaultValue": "",
        "required": true
      },
      {
        "name": "Distance",
        "description": "distance threshold",
        "type": "float",
        "defaultValue": 10,
        "min": 0,
        "required": true
      },
      {
        "name": "Units",
        "description": "The units for the distance",
        "type": "dropdown",
        "defaultValue": "kilometers",
        "options": [
          "feet",
          "meters",
          "miles",
          "kilometers",
          "degrees"
        ],
        "required": true
      }
    ],
    "execution": {
      "stateMode": "layers",
      "inputs": [
        {
          "parameter": "Layer",
          "kind": "layer",
          "geometryTypes": [
            "Point",
            "MultiPoint"
          ],
          "cardinality": "one",
          "selectionAware": true
        }
      ],
      "outputs": [
        {
          "kind": "layer",
          "operation": "add",
          "geometryType": "Point"
        }
      ],
      "mutatesState": true,
      "producesArtifacts": false
    }
  },
  {
    "key": "RandomPointsTool",
    "name": "Random Points",
    "description": "Adds random points within selected polygon",
    "headlessSupported": true,
    "parameters": [
      {
        "name": "Points Count",
        "description": "Number of random points to generate.",
        "type": "int",
        "defaultValue": 10,
        "min": 1,
        "required": true
      },
      {
        "name": "Inside Polygon",
        "description": "Generate points inside polygon",
        "type": "boolean",
        "defaultValue": false
      },
      {
        "name": "Polygon",
        "description": "Polygon to add random points within.",
        "type": "dropdown",
        "defaultValue": ""
      }
    ],
    "execution": {
      "stateMode": "layers",
      "inputs": [
        {
          "parameter": "Polygon",
          "kind": "layer",
          "geometryTypes": [
            "Polygon",
            "MultiPolygon"
          ],
          "cardinality": "one",
          "selectionAware": false,
          "when": {
            "parameter": "Inside Polygon",
            "equals": true
          }
        }
      ],
      "outputs": [
        {
          "kind": "layer",
          "operation": "add",
          "geometryType": "Point"
        }
      ],
      "mutatesState": true,
      "producesArtifacts": false
    }
  },
  {
    "key": "AddAIGeneratedFieldTool",
    "name": "Add AI-Generated Field",
    "description": "Generate a new attribute field from existing feature attributes using AI",
    "headlessSupported": true,
    "parameters": [
      {
        "name": "Input Layer",
        "description": "The input layer to enrich",
        "type": "dropdown",
        "defaultValue": ""
      },
      {
        "name": "Source Fields",
        "description": "Comma-separated source fields to send to AI",
        "type": "text",
        "defaultValue": ""
      },
      {
        "name": "Instruction",
        "description": "The instruction used to generate the new field",
        "type": "text",
        "defaultValue": "",
        "required": true
      },
      {
        "name": "Output Field Name",
        "description": "The field to write",
        "type": "text",
        "defaultValue": "",
        "required": true
      },
      {
        "name": "Output Type",
        "description": "The output field type",
        "type": "dropdown",
        "defaultValue": "text",
        "options": [
          "text",
          "number",
          "boolean"
        ],
        "required": true
      },
      {
        "name": "Overwrite Existing Field",
        "description": "Overwrite existing values in the output field",
        "type": "boolean",
        "defaultValue": false
      }
    ],
    "execution": {
      "stateMode": "featureCollection",
      "inputs": [
        {
          "kind": "featureCollection",
          "geometryTypes": [
            "Point",
            "MultiPoint",
            "LineString",
            "MultiLineString",
            "Polygon",
            "MultiPolygon"
          ],
          "cardinality": "many",
          "selectionAware": true
        }
      ],
      "outputs": [
        {
          "kind": "featureCollection",
          "operation": "update",
          "geometryType": "preserved"
        }
      ],
      "mutatesState": true,
      "producesArtifacts": false
    }
  },
  {
